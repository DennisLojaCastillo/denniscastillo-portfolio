---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Siden findes ikke">
  <h1 class="text-3xl font-medium tracking-tight">Siden findes ikke</h1>
  <p class="mt-4 text-[--color-muted]">Linket er forkert, eller siden er flyttet.</p>
  <a href="/" class="mt-8 inline-block border-b border-[--color-ink] pb-1 text-sm">Tilbage til forsiden</a>
</BaseLayout>
