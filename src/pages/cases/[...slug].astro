---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Reveal from '../../components/Reveal.astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const cases = await getCollection('cases', ({ data }) => !data.draft);
  return cases.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
};

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);

const meta = [
  ['Kunde', d.client],
  ['Type', d.type],
  ['Timeline', d.year],
  ['Industri', d.industry],
].filter(([, v]) => v);
---

<BaseLayout title={d.title} description={d.excerpt} ctaLabel="Start projekt">
  <section class="case-hero">
    <p class="eyebrow"><a href="/portfolio/">Portfolio</a></p>
    <!-- Samme view-transition-name som titlen på forsiden, så den glider over. -->
    <h1 class="case-title display" style={`view-transition-name: case-title-${entry.id}`}>{d.title}</h1>
    {d.excerpt && <p class="lead">{d.excerpt}</p>}

    {
      meta.length > 0 && (
        <dl class="meta">
          {meta.map(([k, v]) => (
            <div>
              <dt class="eyebrow">{k}</dt>
              <dd>{v}</dd>
            </div>
          ))}
        </dl>
      )
    }
  </section>

  {
    d.cover && (
      <section class="cover-band">
        <img
          src={d.cover}
          alt=""
          class="cover"
          decoding="async"
          style={`view-transition-name: case-cover-${entry.id}`}
        />
      </section>
    )
  }

  <section class="band">
    <div class="split">
      <Reveal class="band-head">
        <h2 class="eyebrow">Projekt overblik</h2>
      </Reveal>
      <Reveal class="prose">
        <Content />
      </Reveal>
    </div>
  </section>

  {
    d.challenge.length > 0 && (
      <section class="band">
        <div class="split">
          <Reveal class="band-head">
            <h2 class="eyebrow">Udfordringen &amp; løsningen</h2>
          </Reveal>
          <Reveal class="prose">
            {d.challenge.map((p) => <p>{p}</p>)}
            {d.url && (
              <a class="button result" href={d.url} rel="noopener">
                Se resultatet
              </a>
            )}
          </Reveal>
        </div>
      </section>
    )
  }

  {
    d.testimonial && (
      <section class="band">
        <Reveal>
          <figure class="quote">
            <blockquote class="display">{d.testimonial.quote}</blockquote>
            <figcaption>
              <strong>{d.testimonial.name}</strong>
              {d.testimonial.role && <span>{d.testimonial.role}</span>}
            </figcaption>
          </figure>
        </Reveal>
      </section>
    )
  }

  {
    d.gallery.length > 0 && (
      <section class="band gallery">
        {d.gallery.map((src) => (
          <img src={src} alt="" loading="lazy" decoding="async" />
        ))}
      </section>
    )
  }
</BaseLayout>

<style>
  .case-hero { padding: var(--space-24) 0 var(--space-16); }
  .case-hero .eyebrow a { transition: color var(--duration-fast) ease; }
  .case-hero .eyebrow a:hover { color: var(--color-ink); }
  .case-title {
    margin: var(--space-6) 0 0;
    font-size: clamp(2.75rem, 7vw, 6rem);
    max-width: 16ch;
  }
  .lead {
    margin: var(--space-8) 0 0;
    max-width: 52ch;
    color: var(--color-muted);
    font-size: var(--text-lg);
    line-height: 1.6;
  }

  .meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: var(--space-8);
    margin: var(--space-16) 0 0;
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-line);
  }
  .meta dt { margin-bottom: var(--space-2); }
  .meta dd { margin: 0; }

  .cover-band { padding-bottom: var(--space-16); }
  .cover {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: var(--space-3);
    background: var(--color-shade);
  }

  .split {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: var(--space-8) var(--space-16);
    align-items: start;
  }
  .result { margin-top: var(--space-4); }

  .quote { margin: 0; max-width: 40rem; }
  .quote blockquote {
    margin: 0 0 var(--space-8);
    font-size: var(--text-2xl);
    line-height: 1.2;
  }
  .quote blockquote::before { content: '\201C'; }
  .quote blockquote::after { content: '\201D'; }
  .quote figcaption { display: grid; gap: var(--space-1); }
  .quote figcaption span { color: var(--color-muted); font-size: var(--text-sm); }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    gap: var(--space-6);
  }
  .gallery img { width: 100%; border-radius: var(--space-3); }

  @media (max-width: 800px) {
    .case-hero { padding: var(--space-16) 0 var(--space-12); }
    .split { grid-template-columns: 1fr; }
  }
</style>
