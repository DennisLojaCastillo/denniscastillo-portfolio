---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Reveal from '../components/Reveal.astro';
import CaseFeature from '../components/CaseFeature.astro';

const cases = (await getCollection('cases', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout
  title="Portfolio"
  description="Hvert projekt tager udgangspunkt i en konkret udfordring og kombinerer design, teknologi og brugeroplevelse."
  ctaLabel="Start projekt"
>
  <PageHero
    title="Digitale løsninger skabt til at gøre en forskel"
    eyebrow="Seneste projekter"
    lead="Hvert projekt tager udgangspunkt i en konkret udfordring og kombinerer design, teknologi og brugeroplevelse. Fokus er på at skabe gennemarbejdede, skalerbare og visuelt stærke digitale løsninger."
  />

  <section class="band work">
    {
      cases.map((item, i) => (
        <Reveal class="case-item">
          <CaseFeature item={item} index={i} />
        </Reveal>
      ))
    }
  </section>
</BaseLayout>

<style>
  .work { padding-bottom: var(--space-32); }
</style>
