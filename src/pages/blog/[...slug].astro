---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
};

const { entry } = Astro.props;
const { Content } = await render(entry);
const fmt = new Intl.DateTimeFormat('da-DK', { dateStyle: 'long', timeZone: 'UTC' });
---

<BaseLayout title={entry.data.title} description={entry.data.excerpt}>
  <article>
    <h1 class="text-3xl font-medium tracking-tight">{entry.data.title}</h1>
    <time datetime={entry.data.date.toISOString()} class="mt-4 block text-sm text-[--color-muted]">
      {fmt.format(entry.data.date)}
    </time>
    <div class="prose-sm mt-10 max-w-none">
      <Content />
    </div>
  </article>
</BaseLayout>
