---
import data from '../../data/preview.json';
---

<!doctype html>
<html lang="da">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Retning B, struktureret</title>
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <div class="flag">Retning B, struktureret <a href="/design">skift</a></div>

    <header>
      <a class="wordmark" href="/design/b">{data.name}</a>
      <span class="role">{data.role}</span>
      <nav>
        <a href="#arbejde">Arbejde</a>
        <a href="#om">Om</a>
        <a href="#kontakt">Kontakt</a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <div class="hero-text">
          <p class="label">Freelance, Sjælland</p>
          <h1>{data.heroB}</h1>
          <p class="lead">{data.lead}</p>
        </div>
        <div class="hero-side">
          <div class="portrait" role="img" aria-label="Portræt kommer her"><span>Portræt</span></div>
          <dl class="facts">
            <div><dt>Tilgængelig</dt><dd>Fra oktober 2026</dd></div>
            <div><dt>Arbejder med</dt><dd>Design, frontend, drift</dd></div>
            <div><dt>Baseret</dt><dd>Sjælland, Danmark</dd></div>
          </dl>
        </div>
      </section>

      <section id="arbejde" class="work">
        <div class="section-head">
          <p class="label">01 &mdash; Arbejde</p>
          <p class="count">{data.cases.length} udvalgte</p>
        </div>
        <ol>
          {
            data.cases.map((c, i) => (
              <li>
                <a href="#">
                  <span class="num">{String(i + 1).padStart(2, '0')}</span>
                  <span class="title">{c.title}</span>
                  <span class="client">{c.client}</span>
                  <span class="services">{c.services.join(' / ')}</span>
                  <span class="year">{c.year}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </section>

      <section id="om" class="about">
        <div class="section-head">
          <p class="label">02 &mdash; Om</p>
        </div>
        <div class="about-grid">
          <p>
            Jeg har bygget websites i over ti år, de senere år mest for virksomheder der er vokset
            fra deres første side.
          </p>
          <p>
            Jeg arbejder alene, og det er et valg. Færre led mellem beslutning og kode, og ingen
            overlevering mellem den der tegner og den der bygger.
          </p>
          <p>
            Teknisk betyder det som regel statiske sider, versioneret indhold og automatisk deploy.
            Sider der stadig kan vedligeholdes om tre år.
          </p>
        </div>
      </section>

      <section id="kontakt" class="contact">
        <div class="section-head">
          <p class="label">03 &mdash; Kontakt</p>
        </div>
        <div class="contact-grid">
          <h2>Har du noget der skal bygges?</h2>
          <a href="mailto:hej@denniscastillo.dk">hej@denniscastillo.dk</a>
        </div>
      </section>
    </main>

    <footer>
      <span>2026 {data.name}</span>
      <span class="links"><a href="#">LinkedIn</a><a href="#">GitHub</a></span>
    </footer>

    <style>
      :root {
        --ink: #0b0d10;
        --muted: #71767e;
        --line: #e6e8ea;
        --paper: #ffffff;
        --shade: #f4f5f6;
        --mono: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, monospace;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      a { color: inherit; text-decoration: none; }
      .flag {
        position: fixed; top: 0; left: 0; right: 0; z-index: 10;
        background: var(--ink); color: var(--paper);
        font-family: var(--mono); font-size: 0.6875rem; letter-spacing: 0.06em;
        padding: 0.5rem 1.5rem; display: flex; gap: 1rem; justify-content: space-between;
      }
      .label {
        font-family: var(--mono); font-size: 0.6875rem;
        letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); margin: 0;
      }

      header {
        display: grid; grid-template-columns: 1fr 1fr auto; align-items: center; gap: 2rem;
        max-width: 68rem; margin: 0 auto; padding: 4rem 2rem 1.25rem;
        border-bottom: 1px solid var(--line);
      }
      .wordmark { font-size: 0.875rem; font-weight: 500; }
      .role { font-family: var(--mono); font-size: 0.6875rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
      nav { display: flex; gap: 1.75rem; font-size: 0.875rem; }
      nav a { color: var(--muted); transition: color 0.15s ease; }
      nav a:hover { color: var(--ink); }

      main { max-width: 68rem; margin: 0 auto; padding: 0 2rem; }

      .hero {
        display: grid; grid-template-columns: 1.6fr 1fr; gap: 4rem;
        padding: 5rem 0 6rem; border-bottom: 1px solid var(--line);
      }
      h1 {
        font-size: clamp(2rem, 4.2vw, 3.25rem); line-height: 1.08;
        letter-spacing: -0.032em; font-weight: 500; margin: 1.75rem 0 1.75rem; max-width: 18ch;
      }
      .lead { color: var(--muted); line-height: 1.7; max-width: 48ch; margin: 0; font-size: 0.9375rem; }
      .hero-side { display: grid; gap: 2rem; align-content: start; }
      .portrait {
        aspect-ratio: 1; background: var(--shade); display: grid; place-items: center;
        font-family: var(--mono); font-size: 0.6875rem; letter-spacing: 0.1em;
        text-transform: uppercase; color: var(--muted);
      }
      .facts { margin: 0; display: grid; gap: 1rem; }
      .facts div { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; border-top: 1px solid var(--line); padding-top: 0.75rem; }
      dt { font-family: var(--mono); font-size: 0.6875rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
      dd { margin: 0; font-size: 0.8125rem; }

      .section-head {
        display: flex; justify-content: space-between; align-items: baseline;
        padding: 3rem 0 1.25rem;
      }
      .count { font-family: var(--mono); font-size: 0.6875rem; letter-spacing: 0.08em; color: var(--muted); margin: 0; }

      .work ol { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--ink); }
      .work li { border-bottom: 1px solid var(--line); }
      .work a {
        display: grid;
        grid-template-columns: 3rem minmax(0, 1.3fr) minmax(0, 1fr) minmax(0, 1.2fr) 4rem;
        gap: 1.5rem; align-items: baseline; padding: 1.5rem 0;
        transition: background 0.15s ease, padding 0.15s ease;
      }
      .work a:hover { background: var(--shade); padding-left: 1rem; padding-right: 1rem; }
      .num, .year { font-family: var(--mono); font-size: 0.6875rem; color: var(--muted); letter-spacing: 0.06em; }
      .year { text-align: right; }
      .title { font-size: 1.0625rem; letter-spacing: -0.015em; }
      .client, .services { font-size: 0.8125rem; color: var(--muted); }

      .about { border-top: 1px solid var(--line); }
      .about-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.5rem; padding-bottom: 4rem; }
      .about-grid p { margin: 0; color: var(--muted); line-height: 1.7; font-size: 0.9375rem; }

      .contact { border-top: 1px solid var(--line); }
      .contact-grid {
        display: grid; grid-template-columns: 1fr 1fr; gap: 2rem;
        align-items: baseline; padding-bottom: 5rem;
      }
      h2 { font-size: clamp(1.375rem, 2.6vw, 1.875rem); letter-spacing: -0.025em; font-weight: 500; margin: 0; }
      .contact-grid a { font-size: 1.0625rem; border-bottom: 1px solid var(--ink); padding-bottom: 0.2rem; justify-self: start; }

      footer {
        max-width: 68rem; margin: 0 auto; padding: 1.5rem 2rem;
        display: flex; justify-content: space-between;
        border-top: 1px solid var(--line);
        font-family: var(--mono); font-size: 0.6875rem; letter-spacing: 0.06em;
        text-transform: uppercase; color: var(--muted);
      }
      .links { display: flex; gap: 1.5rem; }

      @media (max-width: 860px) {
        header { grid-template-columns: 1fr auto; }
        .role { display: none; }
        .hero, .about-grid, .contact-grid { grid-template-columns: 1fr; gap: 2.5rem; }
        .work a { grid-template-columns: 2.5rem 1fr 3.5rem; row-gap: 0.5rem; }
        .client, .services { grid-column: 2 / 3; }
      }
    </style>
  </body>
</html>
