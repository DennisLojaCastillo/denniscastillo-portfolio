---
import data from '../../data/preview.json';
import { Heading, Reveal, Badge } from '../../components/Motion';

const headline = 'Design og kode der holder.';
const marquee = ['Webdesign', 'Frontend', 'Astro', 'Designsystemer', 'Drift', 'Tilgængelighed'];
---

<!doctype html>
<html lang="da">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Retning C, oversized</title>
    <meta name="robots" content="noindex" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <div class="flag">Retning C, oversized og bevægelse <a href="/design">skift</a></div>

    <header>
      <a class="wordmark" href="/design/c">{data.name}</a>
      <Badge client:idle text="Ledig fra oktober" className="badge" />
      <nav>
        <a href="#arbejde">Arbejde</a>
        <a href="#om">Om</a>
        <a href="#kontakt">Kontakt</a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <Heading client:load as="h1" text={headline} delay={110} className="hero-title" />
        <Reveal client:visible delay={0.6} distance={24} className="hero-meta">
          <p>{data.lead}</p>
          <span class="scroll-hint">Scroll</span>
        </Reveal>
      </section>

      <div class="marquee" aria-hidden="true">
        <div class="marquee-track">
          {[0, 1].map(() => marquee.map((m) => <span>{m}</span>))}
        </div>
      </div>

      <section id="arbejde" class="work">
        <p class="label">Udvalgt arbejde</p>
        <Reveal client:visible>
          <ul>
            {
              data.cases.map((c, i) => (
                <li data-row>
                  <a href="#">
                    <span class="row-num">{String(i + 1).padStart(2, '0')}</span>
                    <span class="row-title">{c.title}</span>
                    <span class="row-meta">{c.services.join(' / ')}</span>
                    <span class="row-year">{c.year}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </Reveal>
        <div class="peek" data-peek aria-hidden="true"><span>Billede</span></div>
      </section>

      <section id="om" class="about">
        <p class="label">Om</p>
        <Reveal client:visible>
          <p class="big">
            Jeg arbejder alene, hele vejen fra skitse til drift. Færre led mellem beslutning og kode.
          </p>
        </Reveal>
        <Reveal client:visible delay={0.15}>
          <div class="about-cols">
            <p>
              Over ti år med websites, de senere år mest for virksomheder der er vokset fra deres
              første side.
            </p>
            <p>
              Teknisk betyder det statiske sider, versioneret indhold og automatisk deploy. Sider der
              stadig kan vedligeholdes om tre år.
            </p>
          </div>
        </Reveal>
      </section>

      <section id="kontakt" class="contact">
        <p class="label">Kontakt</p>
        <Reveal client:visible>
          <a class="mail" href="mailto:hej@denniscastillo.dk">hej@denniscastillo.dk</a>
        </Reveal>
      </section>
    </main>

    <footer>
      <span>2026 {data.name}</span>
      <span class="links"><a href="#">LinkedIn</a><a href="#">GitHub</a></span>
    </footer>

    <!-- Global, fordi Astros scoped styles ikke naar ind i React-oeerne. -->
    <style is:global>
      :root {
        --ink: #0c0c0c;
        --muted: #8a8a8a;
        --line: #e8e8e6;
        --paper: #f7f7f5;
        --shade: #ebebe8;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }
      a { color: inherit; text-decoration: none; }

      /* AnimatedContent skjuler sig selv med .invisible og regner med Tailwind.
         Tailwind er ikke indlaest her, saa reglen defineres selv. Uden JavaScript
         vises indholdet med det samme, saa siden aldrig staar tom. */
      .invisible { visibility: hidden; }
      :root:not(.js) .invisible { visibility: visible !important; }

      /* BlurText renderer sine ord som inline-block og forventer Tailwinds flex. */
      .blur-text { display: flex; flex-wrap: wrap; }

      .flag {
        position: fixed; inset: 0 0 auto 0; z-index: 30;
        background: var(--ink); color: var(--paper);
        font-size: 0.6875rem; letter-spacing: 0.08em; text-transform: uppercase;
        padding: 0.5rem 1.5rem; display: flex; justify-content: space-between;
      }
      .flag a { opacity: 0.55; }

      header {
        position: sticky; top: 0; z-index: 20;
        display: flex; justify-content: space-between; align-items: center; gap: 2rem;
        padding: 3.5rem 2rem 1rem;
      }
      .wordmark { font-size: 0.875rem; font-weight: 500; }
      .badge {
        display: inline-block;
        font-size: 0.6875rem; letter-spacing: 0.12em; text-transform: uppercase;
        margin-right: auto;
      }
      nav { display: flex; gap: 1.75rem; font-size: 0.875rem; }
      nav a { color: var(--muted); transition: color 0.2s ease; }
      nav a:hover { color: var(--ink); }

      main { padding: 0 2rem; }

      .hero { min-height: 80vh; display: flex; flex-direction: column; justify-content: center; padding: 2rem 0 4rem; }
      .hero-title {
        margin: 0;
        font-size: clamp(3rem, 13vw, 11rem);
        line-height: 0.88;
        letter-spacing: -0.055em;
        font-weight: 500;
      }
      .hero-meta {
        display: flex; justify-content: space-between; align-items: flex-end;
        gap: 3rem; margin-top: 4rem;
      }
      .hero-meta p { margin: 0; max-width: 42ch; color: var(--muted); line-height: 1.6; font-size: 0.9375rem; }
      .scroll-hint {
        font-size: 0.6875rem; letter-spacing: 0.14em; text-transform: uppercase;
        color: var(--muted); white-space: nowrap;
      }

      .marquee { overflow: hidden; border-block: 1px solid var(--line); padding: 1.25rem 0; margin: 0 -2rem; }
      .marquee-track {
        display: flex; gap: 3rem; width: max-content;
        animation: slide 32s linear infinite;
        font-size: 0.8125rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted);
      }
      @keyframes slide { to { transform: translateX(-50%); } }

      .label {
        font-size: 0.6875rem; letter-spacing: 0.14em; text-transform: uppercase;
        color: var(--muted); margin: 0 0 2rem;
      }

      .work { padding: 7rem 0; position: relative; }
      .work ul { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
      .work li { border-bottom: 1px solid var(--line); }
      .work a {
        display: grid; grid-template-columns: 3.5rem 1fr auto 5rem;
        gap: 1.5rem; align-items: baseline; padding: 1.75rem 0;
        transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .work li:hover a { transform: translateX(1.25rem); }
      .work li:hover .row-title { opacity: 1; }
      .work ul:hover .row-title { opacity: 0.32; }
      .row-title {
        font-size: clamp(1.75rem, 5vw, 3.75rem); line-height: 1;
        letter-spacing: -0.04em; font-weight: 500;
        transition: opacity 0.35s ease;
      }
      .row-num, .row-year, .row-meta {
        font-size: 0.6875rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted);
      }
      .row-year { text-align: right; }

      .peek {
        position: fixed; top: 0; left: 0; z-index: 5;
        width: 20rem; aspect-ratio: 4 / 3; background: var(--shade);
        display: grid; place-items: center;
        font-size: 0.6875rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted);
        pointer-events: none; opacity: 0;
        transform: translate(-50%, -50%) scale(0.92);
        transition: opacity 0.3s ease, transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .peek.on { opacity: 1; transform: translate(-50%, -50%) scale(1); }

      .about { padding: 5rem 0 7rem; border-top: 1px solid var(--line); }
      .big {
        font-size: clamp(1.75rem, 4.5vw, 3.25rem); line-height: 1.08;
        letter-spacing: -0.035em; font-weight: 500; margin: 0 0 4rem; max-width: 20ch;
      }
      .about-cols { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 3rem; max-width: 58rem; }
      .about-cols p { margin: 0; color: var(--muted); line-height: 1.7; font-size: 0.9375rem; }

      .contact { padding: 5rem 0 8rem; border-top: 1px solid var(--line); }
      .mail {
        display: inline-block;
        font-size: clamp(1.75rem, 6vw, 5rem); line-height: 1;
        letter-spacing: -0.045em; font-weight: 500;
        background-image: linear-gradient(var(--ink), var(--ink));
        background-size: 0% 2px; background-repeat: no-repeat; background-position: 0 100%;
        transition: background-size 0.5s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .mail:hover { background-size: 100% 2px; }

      footer {
        display: flex; justify-content: space-between; padding: 1.5rem 2rem;
        border-top: 1px solid var(--line);
        font-size: 0.6875rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted);
      }
      .links { display: flex; gap: 1.5rem; }

      @media (max-width: 800px) {
        header { flex-wrap: wrap; }
        .badge { order: 3; margin-right: 0; }
        .hero-meta, .about-cols { grid-template-columns: 1fr; flex-direction: column; align-items: flex-start; gap: 1.5rem; }
        .work a { grid-template-columns: 2.5rem 1fr 3.5rem; }
        .row-meta { display: none; }
        .peek { display: none; }
      }

      @media (prefers-reduced-motion: reduce) {
        .marquee-track { animation: none; }
        .work li:hover a { transform: none; }
        .peek { display: none; }
        .invisible { visibility: visible; }
        html { scroll-behavior: auto; }
      }
    </style>

    <script>
      // Kun billedet der foelger markoeren. Resten af bevaegelsen kommer fra
      // React Bits-komponenterne, som selv slaar fra ved reduceret bevaegelse.
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const peek = document.querySelector('[data-peek]') as HTMLElement | null;
        const rows = document.querySelectorAll('[data-row]');

        if (peek && rows.length) {
          let x = 0, y = 0, cx = 0, cy = 0, raf: number | null = null;

          const loop = () => {
            cx += (x - cx) * 0.12;
            cy += (y - cy) * 0.12;
            peek.style.left = cx + 'px';
            peek.style.top = cy + 'px';
            raf = requestAnimationFrame(loop);
          };

          rows.forEach((row) => {
            row.addEventListener('mouseenter', () => {
              peek.classList.add('on');
              if (raf === null) raf = requestAnimationFrame(loop);
            });
            row.addEventListener('mouseleave', () => peek.classList.remove('on'));
          });

          window.addEventListener('mousemove', (e) => {
            x = e.clientX;
            y = e.clientY;
          });
        }
      }
    </script>
  </body>
</html>
