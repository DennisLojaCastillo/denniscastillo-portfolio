---
const directions = [
  {
    href: '/design/a',
    label: 'A',
    name: 'Redaktionelt',
    text: 'Stor typografi, meget luft, rolig rytme. Portrættet fylder. Tættest på Apple-referencen. Virker bedst når billederne er stærke.',
  },
  {
    href: '/design/b',
    label: 'B',
    name: 'Struktureret',
    text: 'Stramt gitter, hårfine linjer, små mono-labels. Tættest på Linear og Stripe. Signalerer håndværk og præcision frem for stemning.',
  },
];
---

<!doctype html>
<html lang="da">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Designretninger</title>
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <main>
      <p class="kicker">Til gennemsyn</p>
      <h1>To retninger</h1>
      <p class="lead">
        Samme indhold, to formsprog. Åbn dem ved siden af hinanden. Typografien er systemskrifter
        indtil videre, så de rigtige skrifter vælges når retningen er valgt.
      </p>
      <ul>
        {
          directions.map((d) => (
            <li>
              <a href={d.href}>
                <span class="label">{d.label}</span>
                <span class="body">
                  <strong>{d.name}</strong>
                  <span>{d.text}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </main>

    <style>
      :root {
        --ink: #101010;
        --muted: #6f6f6f;
        --line: #e4e4e2;
        --paper: #fbfbf9;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      main { max-width: 42rem; margin: 0 auto; padding: 6rem 1.5rem; }
      .kicker {
        font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase;
        color: var(--muted); margin: 0 0 1.5rem;
      }
      h1 { font-size: 2.5rem; letter-spacing: -0.03em; font-weight: 500; margin: 0 0 1.5rem; }
      .lead { color: var(--muted); line-height: 1.6; margin: 0 0 3rem; max-width: 34rem; }
      ul { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
      li { border-bottom: 1px solid var(--line); }
      a {
        display: grid; grid-template-columns: 3rem 1fr; gap: 1.5rem;
        padding: 2rem 0; text-decoration: none; color: inherit;
        transition: opacity 0.2s ease;
      }
      a:hover { opacity: 0.55; }
      .label { font-size: 0.875rem; color: var(--muted); }
      .body { display: grid; gap: 0.5rem; }
      strong { font-weight: 500; }
      .body span { color: var(--muted); line-height: 1.6; font-size: 0.9375rem; }
    </style>
  </body>
</html>
