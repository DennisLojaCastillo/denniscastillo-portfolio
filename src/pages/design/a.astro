---
import data from '../../data/preview.json';
---

<!doctype html>
<html lang="da">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Retning A, redaktionelt</title>
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <div class="flag">Retning A, redaktionelt <a href="/design">skift</a></div>

    <header>
      <a class="wordmark" href="/design/a">{data.name}</a>
      <nav>
        <a href="#arbejde">Arbejde</a>
        <a href="#om">Om</a>
        <a href="#kontakt">Kontakt</a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <h1>{data.heroA}</h1>
        <div class="hero-foot">
          <p>{data.lead}</p>
          <a class="cta" href="#arbejde">Se arbejdet</a>
        </div>
      </section>

      <section class="portrait">
        <div class="portrait-img" role="img" aria-label="Portræt kommer her">
          <span>Portræt</span>
        </div>
        <aside>
          <p class="kicker">Om</p>
          <p>
            Jeg har bygget websites i over ti år, de senere år mest for virksomheder der er vokset
            fra deres første side. Jeg arbejder alene, og det er et valg: færre led, hurtigere svar.
          </p>
          <p>Baseret på Sjælland. Arbejder i hele landet.</p>
        </aside>
      </section>

      <section id="arbejde" class="work">
        <p class="kicker">Udvalgt arbejde</p>
        {
          data.cases.map((c, i) => (
            <article>
              <div class="cover" role="img" aria-label={`Billede fra ${c.title}`}>
                <span>{String(i + 1).padStart(2, '0')}</span>
              </div>
              <div class="meta">
                <h2>{c.title}</h2>
                <p class="excerpt">{c.excerpt}</p>
                <dl>
                  <div><dt>Kunde</dt><dd>{c.client}</dd></div>
                  <div><dt>År</dt><dd>{c.year}</dd></div>
                  <div><dt>Ydelser</dt><dd>{c.services.join(', ')}</dd></div>
                </dl>
              </div>
            </article>
          ))
        }
      </section>

      <section id="kontakt" class="contact">
        <h2>Har du noget der skal bygges?</h2>
        <a href="mailto:hej@denniscastillo.dk">hej@denniscastillo.dk</a>
      </section>
    </main>

    <footer>
      <span>2026 {data.name}</span>
      <span>LinkedIn &nbsp; GitHub</span>
    </footer>

    <style>
      :root {
        --ink: #14130f;
        --muted: #78746c;
        --line: #e3e0d8;
        --paper: #faf9f5;
        --shade: #f0eee7;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }
      .flag {
        position: fixed; top: 0; left: 0; right: 0; z-index: 10;
        background: var(--ink); color: var(--paper);
        font-size: 0.75rem; letter-spacing: 0.04em;
        padding: 0.5rem 1.5rem; display: flex; gap: 1rem; justify-content: space-between;
      }
      .flag a { color: inherit; opacity: 0.6; }
      header {
        display: flex; align-items: baseline; justify-content: space-between;
        max-width: 72rem; margin: 0 auto; padding: 4rem 2rem 0;
      }
      .wordmark { font-size: 0.9375rem; font-weight: 500; letter-spacing: -0.01em; }
      nav { display: flex; gap: 2rem; font-size: 0.9375rem; }
      a { color: inherit; text-decoration: none; }
      nav a { color: var(--muted); transition: color 0.2s ease; }
      nav a:hover { color: var(--ink); }
      main { max-width: 72rem; margin: 0 auto; padding: 0 2rem; }

      .hero { padding: 7rem 0 6rem; }
      h1 {
        font-size: clamp(2.75rem, 7vw, 5.5rem);
        line-height: 1.02;
        letter-spacing: -0.04em;
        font-weight: 500;
        margin: 0;
        max-width: 16ch;
      }
      .hero-foot {
        display: grid; grid-template-columns: 1fr auto; gap: 3rem;
        align-items: end; margin-top: 4rem;
        border-top: 1px solid var(--line); padding-top: 2rem;
      }
      .hero-foot p { margin: 0; max-width: 46ch; color: var(--muted); line-height: 1.65; }
      .cta {
        white-space: nowrap; font-size: 0.9375rem;
        border-bottom: 1px solid var(--ink); padding-bottom: 0.25rem;
      }

      .portrait {
        display: grid; grid-template-columns: 1.15fr 1fr; gap: 4rem;
        align-items: end; padding: 4rem 0 7rem;
      }
      .portrait-img {
        aspect-ratio: 4 / 5; background: var(--shade);
        display: grid; place-items: center;
        color: var(--muted); font-size: 0.8125rem; letter-spacing: 0.08em; text-transform: uppercase;
      }
      aside p { color: var(--muted); line-height: 1.7; max-width: 42ch; }
      aside p:first-of-type { margin-top: 0; }

      .kicker {
        font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase;
        color: var(--muted); margin: 0 0 2.5rem;
      }

      .work { padding-bottom: 5rem; }
      .work article {
        display: grid; grid-template-columns: 1fr 1fr; gap: 4rem;
        align-items: center; padding: 4rem 0; border-top: 1px solid var(--line);
      }
      .work article:nth-child(even) .cover { order: 2; }
      .cover {
        aspect-ratio: 4 / 3; background: var(--shade);
        display: grid; place-items: center; color: var(--muted); font-size: 2rem; font-weight: 300;
      }
      h2 { font-size: clamp(1.5rem, 2.5vw, 2rem); letter-spacing: -0.025em; font-weight: 500; margin: 0 0 1rem; }
      .excerpt { color: var(--muted); line-height: 1.65; margin: 0 0 2rem; max-width: 42ch; }
      dl { display: flex; flex-wrap: wrap; gap: 2.5rem; margin: 0; }
      dt { font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
      dd { margin: 0.375rem 0 0; font-size: 0.9375rem; }

      .contact {
        border-top: 1px solid var(--line); padding: 6rem 0;
        display: grid; gap: 1.5rem; justify-items: start;
      }
      .contact h2 { margin: 0; }
      .contact a { font-size: clamp(1.25rem, 3vw, 2rem); border-bottom: 1px solid var(--ink); padding-bottom: 0.25rem; }

      footer {
        max-width: 72rem; margin: 0 auto; padding: 2rem;
        display: flex; justify-content: space-between;
        border-top: 1px solid var(--line); font-size: 0.875rem; color: var(--muted);
      }

      @media (max-width: 800px) {
        .hero-foot, .portrait, .work article { grid-template-columns: 1fr; gap: 2rem; }
        .work article:nth-child(even) .cover { order: 0; }
        .hero { padding: 5rem 0 3rem; }
        header { padding-top: 3.5rem; }
      }
    </style>
  </body>
</html>
