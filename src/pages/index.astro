---
import { getEntry, getCollection } from 'astro:content';
import settings from '../data/settings.json';
import BaseLayout from '../layouts/BaseLayout.astro';
import BlurHeading from '../components/BlurHeading.astro';
import Reveal from '../components/Reveal.astro';
import CaseFeature from '../components/CaseFeature.astro';
import CaseList from '../components/CaseList.astro';
import Services from '../components/Services.astro';

const page = await getEntry('pages', 'forside');
if (!page) throw new Error('src/content/pages/forside.md mangler');

const cases = (await getCollection('cases', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);

// De to foerste vises stort med cover. Resten som typografisk liste,
// saa forsiden ikke bliver uendelig lang.
const featured = cases.slice(0, 2);
const rest = cases.slice(2, 6);
---

<BaseLayout
  title={page.data.title}
  description={page.data.description}
  availability={page.data.availability}
>
  <section class="hero">
    <BlurHeading
      as="h1"
      text={page.data.heroTitle ?? page.data.title}
      stagger={110}
      class="hero-title display"
    />

    <Reveal delay={700} class="hero-meta">
      <div class="hero-text">
        <p>{page.data.heroText}</p>
      </div>
      <figure class="portrait">
        {
          page.data.portrait ? (
            <img
              src={page.data.portrait}
              alt={page.data.portraitAlt ?? ''}
              width="560"
              height="700"
              loading="eager"
              decoding="async"
            />
          ) : (
            <div class="portrait-slot"><span class="eyebrow">Portræt</span></div>
          )
        }
      </figure>
    </Reveal>
  </section>

  <section id="arbejde" class="work">
    <h2 class="eyebrow">Udvalgt arbejde</h2>

    {
      cases.length === 0 && (
        <p class="empty">Ingen cases endnu. Opret den første i Pages CMS.</p>
      )
    }

    {featured.map((item) => <Reveal><CaseFeature item={item} /></Reveal>)}

    {
      rest.length > 0 && (
        <Reveal class="rest">
          <CaseList items={rest} />
        </Reveal>
      )
    }

    {
      cases.length > featured.length + rest.length && (
        <a class="more" href="/cases">Se alle {cases.length} cases</a>
      )
    }
  </section>

  <section id="ydelser" class="services-section">
    <h2 class="eyebrow">Hvad jeg laver</h2>
    <Reveal>
      <Services items={page.data.services} />
    </Reveal>
  </section>

  <section id="om" class="about">
    <h2 class="eyebrow">Om</h2>
    <Reveal>
      <p class="lead display">{page.data.aboutLead}</p>
    </Reveal>
    {
      page.data.aboutText.length > 0 && (
        <Reveal delay={120}>
          <div class="about-cols">
            {page.data.aboutText.map((t) => <p>{t}</p>)}
          </div>
        </Reveal>
      )
    }
  </section>

  <section id="kontakt" class="contact">
    <h2 class="eyebrow">Kontakt</h2>
    <Reveal>
      <p class="contact-heading display">{page.data.contactHeading}</p>
      <a class="mail display" href={`mailto:${settings.email}`}>{settings.email}</a>
    </Reveal>
  </section>
</BaseLayout>

<style>
  section {
    max-width: 76rem;
    margin-inline: auto;
  }

  .hero {
    min-height: 82svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 2rem 0 5rem;
  }

  .work { padding: 6rem 0; }
  .services-section { padding: 5rem 0 6rem; border-top: 1px solid var(--color-line); }
  .about { padding: 5rem 0 6rem; border-top: 1px solid var(--color-line); }
  .contact { padding: 5rem 0 9rem; border-top: 1px solid var(--color-line); }

  h2.eyebrow { margin: 0 0 2.5rem; font-weight: 400; }

  .empty { color: var(--color-muted); font-size: 0.9375rem; }
  .more {
    display: inline-block;
    margin-top: 3rem;
    font-size: 0.875rem;
    border-bottom: 1px solid currentColor;
    padding-bottom: 0.25rem;
    color: var(--color-muted);
    transition: color var(--duration-fast) ease;
  }
  .more:hover { color: var(--color-ink); }

  .lead {
    font-size: clamp(1.875rem, 4.5vw, 3.5rem);
    margin: 0 0 4rem;
    max-width: 18ch;
  }
  .about-cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3rem;
    max-width: 58rem;
  }
  .about-cols p {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  .contact-heading {
    font-size: clamp(1.5rem, 3.5vw, 2.5rem);
    margin: 0 0 2rem;
    max-width: 20ch;
  }
  .mail {
    display: inline-block;
    font-size: clamp(1.5rem, 5.5vw, 4.5rem);
    line-height: 1;
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% 1px;
    background-repeat: no-repeat;
    background-position: 0 100%;
    transition: background-size var(--duration-slow) var(--ease-out-soft);
  }
  .mail:hover { background-size: 100% 1px; }

  @media (max-width: 800px) {
    .about-cols { grid-template-columns: 1fr; gap: 2rem; }
    .work { padding: 4rem 0; }
  }
</style>

<style is:global>
  /* Reglerne herunder rammer elementer fra BlurHeading og Reveal, som
     Astros scoped styles ikke naar ind i. */
  .hero-title {
    margin: 0;
    font-size: clamp(2.75rem, 11vw, 9.5rem);
    line-height: 0.9;
  }
  .hero-meta {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 3rem;
    align-items: end;
    margin-top: 3.5rem;
  }
  .hero-meta .hero-text p {
    margin: 0;
    max-width: 46ch;
    color: var(--color-muted);
    font-size: 0.9375rem;
  }
  .hero-meta .portrait {
    margin: 0;
    width: clamp(8rem, 18vw, 14rem);
  }
  .hero-meta .portrait img,
  .hero-meta .portrait-slot {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  .hero-meta .portrait-slot {
    background: var(--color-shade);
    display: grid;
    place-items: center;
  }
  .rest { margin-top: 5rem; }

  @media (max-width: 700px) {
    .hero-meta {
      grid-template-columns: auto 1fr;
      align-items: center;
      gap: 1.5rem;
    }
    .hero-meta .portrait { order: -1; width: 5.5rem; }
    .rest { margin-top: 3.5rem; }
  }
</style>
