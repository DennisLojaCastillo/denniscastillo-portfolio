---
interface Props {
  items: { title: string; text?: string }[];
}
const { items } = Astro.props;
---

{
  items.length > 0 && (
    <ol class="services">
      {items.map((item, i) => (
        <li>
          <span class="num eyebrow">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="title">{item.title}</h3>
          {item.text && <p>{item.text}</p>}
        </li>
      ))}
    </ol>
  )
}

<style>
  .services {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: var(--space-12);
  }
  li {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-line);
  }
  .num { margin: 0; }
  .title {
    font-size: var(--text-lg);
    font-weight: 500;
    letter-spacing: -0.018em;
    margin: 0;
  }
  p {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-base);
    line-height: 1.65;
    max-width: 36ch;
  }
</style>
