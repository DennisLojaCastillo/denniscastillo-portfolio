---
interface Props {
  items: { title: string; text?: string }[];
}
const { items } = Astro.props;
---

{
  items.length > 0 && (
    <ol class="services">
      {items.map((item, i) => (
        <li>
          <span class="num eyebrow">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="title">{item.title}</h3>
          {item.text && <p>{item.text}</p>}
        </li>
      ))}
    </ol>
  )
}

<style>
  .services {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 3rem;
    border-top: 1px solid var(--color-line);
    padding-top: 2.5rem;
  }
  li { display: grid; gap: 0.75rem; align-content: start; }
  .num { margin: 0; }
  .title {
    font-size: 1.125rem;
    font-weight: 500;
    letter-spacing: -0.015em;
    margin: 0;
  }
  p {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.9375rem;
    line-height: 1.7;
    max-width: 38ch;
  }
</style>
