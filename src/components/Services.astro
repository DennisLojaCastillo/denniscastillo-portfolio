---
interface Props {
  items: { title: string; text?: string; href?: string }[];
}
const { items } = Astro.props;
---

{
  items.length > 0 && (
    <ul class="services">
      {items.map((item) => (
        <li>
          <h3 class="title display">
            {item.href ? <a href={item.href}>{item.title}</a> : item.title}
          </h3>
          {item.text && <p>{item.text}</p>}
        </li>
      ))}
    </ul>
  )
}

<style>
  /* Typografisk liste: titel til venstre, tekst til højre, en linje
     imellem. Ingen kort og ingen numre. */
  .services {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4) var(--space-12);
    align-items: baseline;
    padding: var(--space-8) 0;
    border-top: 1px solid var(--color-line);
  }
  .title {
    font-size: var(--text-2xl);
    margin: 0;
  }
  .title a {
    text-decoration: underline 1px transparent;
    text-underline-offset: 0.12em;
    transition: text-decoration-color var(--duration-fast) ease;
  }
  .title a:hover { text-decoration-color: currentColor; }
  p {
    margin: 0;
    color: var(--color-muted);
    line-height: 1.65;
    max-width: 44ch;
  }

  @media (max-width: 700px) {
    li { grid-template-columns: 1fr; padding: var(--space-6) 0; }
  }
</style>
