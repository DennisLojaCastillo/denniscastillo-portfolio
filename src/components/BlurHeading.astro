---
/**
 * Overskrift hvor ordene stiger op og skarpstiller fra blur, forskudt.
 * Samme effekt som React Bits' BlurText, men i CSS og uden JavaScript.
 */
interface Props {
  text: string;
  as?: 'h1' | 'h2' | 'h3' | 'p';
  class?: string;
  /** Millisekunder mellem hvert ord. */
  stagger?: number;
}

const { text, as: Tag = 'h1', class: className = '', stagger = 110 } = Astro.props;
const words = text.split(' ');
---

<Tag class:list={['blur-heading', className]}>
  {
    words.map((word, i) => (
      <span class="word" style={`--delay:${i * stagger + 120}ms`}>
        {word}{i < words.length - 1 ? ' ' : ''}
      </span>
    ))
  }
</Tag>

<style>
  .blur-heading {
    display: flex;
    flex-wrap: wrap;
  }
  .word {
    display: inline-block;
    /* Lineaer, ikke ease-out. Med en haard ease-out er ordet paa plads laenge
       foer blurren er vaek, og bevaegelsen knaekker i to. */
    animation: word-in 0.8s linear backwards;
    animation-delay: var(--delay);
    will-change: transform, filter, opacity;
  }

  @keyframes word-in {
    0% {
      opacity: 0;
      transform: translateY(50px);
      filter: blur(10px);
    }
    50% {
      opacity: 0.5;
      transform: translateY(-5px);
      filter: blur(5px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .word { animation: none; }
  }
</style>
