---
/**
 * Tekst med et lys der langsomt glider hen over. Samme effekt som
 * React Bits' ShinyText, men i CSS og uden JavaScript.
 */
interface Props {
  text: string;
  class?: string;
  /** Sekunder per gennemløb. */
  speed?: number;
}

const { text, class: className = '', speed = 4 } = Astro.props;
---

<span class:list={['shimmer', className]} style={`--speed:${speed}s`}>{text}</span>

<style>
  .shimmer {
    display: inline-block;
    background-image: linear-gradient(
      120deg,
      var(--color-muted) 0%,
      var(--color-muted) 38%,
      var(--color-ink) 50%,
      var(--color-muted) 62%,
      var(--color-muted) 100%
    );
    background-size: 220% auto;
    background-position: 150% center;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: shimmer var(--speed) linear infinite;
  }

  @keyframes shimmer {
    to { background-position: -70% center; }
  }

  @media (prefers-reduced-motion: reduce) {
    .shimmer {
      animation: none;
      background: none;
      -webkit-background-clip: border-box;
      background-clip: border-box;
      color: var(--color-muted);
    }
  }
</style>
