---
import settings from '../data/settings.json';
const path = Astro.url.pathname;
---

<header class="border-b border-[--color-line]">
  <div class="mx-auto flex w-full max-w-3xl items-center justify-between px-6 py-6">
    <a href="/" class="text-sm font-medium tracking-tight">{settings.siteName}</a>
    <nav class="flex gap-6 text-sm">
      {
        settings.nav.map((item) => (
          <a
            href={item.url}
            class:list={[
              'transition-colors hover:text-[--color-ink]',
              path.startsWith(item.url) ? 'text-[--color-ink]' : 'text-[--color-muted]',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
