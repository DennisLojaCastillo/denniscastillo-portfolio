---
import settings from '../data/settings.json';

interface Props {
  availability?: string;
  ctaLabel?: string;
}
const { availability, ctaLabel } = Astro.props;
const path = Astro.url.pathname;
---

<header>
  <div class="bar">
    <a class="wordmark" href="/">{settings.siteName}</a>

    <nav aria-label="Primær">
      {
        settings.nav.map((item) => (
          <a href={item.url} aria-current={path.startsWith(item.url) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="end">
      {availability && <span class="availability eyebrow">{availability}</span>}
      {ctaLabel && <a class="cta" href="/kontakt">{ctaLabel}</a>}
    </div>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid transparent;

    /* Baggrunden traeder froem naar man scroller. Scroll-drevet animation,
       saa det koster ingen JavaScript. Browsere uden understoettelse faar
       bare en gennemsigtig header, hvilket ogsaa er fint. */
    animation: header-solid linear both;
    animation-timeline: scroll();
    animation-range: 0 8rem;
  }
  @keyframes header-solid {
    to {
      background-color: color-mix(in srgb, var(--color-paper) 78%, transparent);
      backdrop-filter: saturate(180%) blur(20px);
      -webkit-backdrop-filter: saturate(180%) blur(20px);
      border-bottom-color: var(--color-line);
    }
  }

  .bar {
    max-width: var(--measure);
    margin-inline: auto;
    padding: var(--space-4) var(--gutter);
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }

  .wordmark {
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  nav {
    display: flex;
    gap: var(--space-6);
    font-size: var(--text-sm);
    margin-inline: auto;
  }
  nav a {
    color: var(--color-muted);
    transition: color var(--duration-fast) ease;
  }
  nav a:hover,
  nav a[aria-current='page'] { color: var(--color-ink); }

  .end { display: flex; align-items: center; gap: var(--space-4); }

  .cta {
    font-size: var(--text-sm);
    padding: var(--space-2) var(--space-4);
    border-radius: 999px;
    background: var(--color-ink);
    color: var(--color-paper);
    transition: opacity var(--duration-fast) ease;
  }
  .cta:hover { opacity: 0.82; }

  @media (max-width: 760px) {
    .bar { gap: var(--space-4); }
    nav { gap: var(--space-4); font-size: var(--text-xs); }
    .availability { display: none; }
  }
  @media (max-width: 520px) {
    nav { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    header { animation: none; background-color: var(--color-paper); border-bottom-color: var(--color-line); }
  }
</style>
