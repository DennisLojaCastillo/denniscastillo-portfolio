---
/**
 * Proces-trin med fast overskrift til venstre. Hvert trin skærpes når det
 * scroller op mod midten. Scroll-drevet, så ingen JavaScript.
 */
interface Props {
  heading?: string;
  /** Kort tekst under overskriften. */
  text?: string;
  steps: { title: string; text?: string }[];
}
const { heading, text, steps } = Astro.props;
---

{
  steps.length > 0 && (
    <div class="process">
      {(heading || text) && (
        <div class="head">
          {heading && <h2 class="heading display">{heading}</h2>}
          {text && <p class="text">{text}</p>}
        </div>
      )}
      <ol class="steps">
        {steps.map((step, i) => (
          <li>
            <span class="num eyebrow">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="title">{step.title}</h3>
            {step.text && <p>{step.text}</p>}
          </li>
        ))}
      </ol>
    </div>
  )
}

<style>
  .process {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: var(--space-16);
    align-items: start;
  }
  .head {
    position: sticky;
    top: var(--space-24);
  }
  .text {
    margin: var(--space-6) 0 0;
    max-width: 36ch;
    color: var(--color-muted);
    line-height: 1.65;
  }
  .heading {
    margin: 0;
    font-size: var(--text-4xl);
    max-width: 12ch;
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-16);
  }
  li {
    display: grid;
    gap: var(--space-3);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-line);
  }
  .num { margin: 0; }
  .title {
    font-size: var(--text-xl);
    font-weight: 500;
    letter-spacing: -0.018em;
    margin: 0;
  }
  p {
    margin: 0;
    color: var(--color-muted);
    line-height: 1.65;
    max-width: 44ch;
  }

  /* Trinnet skærpes fra det er helt inde til det når midten, og bliver
     skarpt derefter. Langformer, se CaseFeature. */
  @supports (animation-timeline: view()) {
    li {
      animation-name: step-in;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: view();
      animation-range: entry 100% cover 50%;
    }
  }
  @keyframes step-in {
    from { opacity: 0.25; }
    to { opacity: 1; }
  }

  @media (max-width: 800px) {
    .process { grid-template-columns: 1fr; gap: var(--space-12); }
    .head { position: static; }
    .heading { font-size: var(--text-3xl); }
    .steps { gap: var(--space-12); }
  }
  @media (prefers-reduced-motion: reduce) {
    li { animation: none; }
  }
</style>
