---
/**
 * Indhold der glider ind når det scroller i syne. Observeren ligger i
 * BaseLayout, så den køres én gang uanset hvor mange Reveal der er på siden.
 */
interface Props {
  class?: string;
  /** Millisekunder før indholdet begynder at glide ind. */
  delay?: number;
}

const { class: className = '', delay = 0 } = Astro.props;
---

<div class:list={['reveal', className]} style={delay ? `--reveal-delay:${delay}ms` : undefined}>
  <slot />
</div>
